  m_TableData:
  - m_Id: 326238208
    m_Localized: Help Grandma
    m_Metadata:
      m_Items: []
  - m_Id: 359792640
    m_Localized: Calm the Kid
    m_Metadata:
      m_Items: []
  - m_Id: 359792641
    m_Localized: Mow the Lawn
    m_Metadata:
      m_Items: []
  - m_Id: 359792642
    m_Localized: Garage Mice
    m_Metadata:
      m_Items: []
  - m_Id: 359792643
    m_Localized: START!
    m_Metadata:
      m_Items: []
  - m_Id: 359792644
    m_Localized: GARAGE MICE
    m_Metadata:
      m_Items: []
  - m_Id: 359792645
    m_Localized: 'MOVE: STICK / WASD    SWING: A / SPACE'
    m_Metadata:
      m_Items: []
  - m_Id: 359792646
    m_Localized: SWEEP!
    m_Metadata:
      m_Items: []
  - m_Id: 359792647
    m_Localized: RESULTS
    m_Metadata:
      m_Items: []
  - m_Id: 359792648
    m_Localized: Player {0}
    m_Metadata:
      m_Items: []
  - m_Id: 359792649
    m_Localized: '{0} mice'
    m_Metadata:
      m_Items: []
  - m_Id: 359792650
    m_Localized: Round {0} / {1}
    m_Metadata:
      m_Items: []
  - m_Id: 359792651
    m_Localized: "ROUND 1\n<size=40%>SPACE / A: jump the churro  \xB7  CTRL / B:
      duck under the balls</size>"
    m_Metadata:
      m_Items: []
  - m_Id: 359792652
    m_Localized: ROUND {0}
    m_Metadata:
      m_Items: []
  - m_Id: 359792653
    m_Localized: '{0} survives!'
    m_Metadata:
      m_Items: []
  - m_Id: 359792654
    m_Localized: Everybody fell!
    m_Metadata:
      m_Items: []
  - m_Id: 359792655
    m_Localized: 'FINAL STRETCH!

      <size=60%>Every grandma is worth x2</size>'
    m_Metadata:
      m_Items: []
  - m_Id: 359792656
    m_Localized: "MOW!\n<size=50%>SPACE / A: TURBO  \xB7  ram with turbo to knock
      bags off\nUnload the bags into your bin</size>"
    m_Metadata:
      m_Items: []
  - m_Id: 359792657
    m_Localized: "FINAL FRENZY!\n<size=60%>The grass grows back \xB7 bags x2</size>"
    m_Metadata:
      m_Items: []
  - m_Id: 11229052665856
    m_Localized: "Joystick: move \xB7 Pick up a grandma and cross without getting
      run over"
    m_Metadata:
      m_Items: []
  - m_Id: 11229094608896
    m_Localized: "A: jump the churro \xB7 Hold B: duck under the balls"
    m_Metadata:
      m_Items: []
  - m_Id: 11229094608897
    m_Localized: "Joystick: drive \xB7 A: turbo \xB7 Unload the bags into your bin"
    m_Metadata:
      m_Items: []
  - m_Id: 11229094608898
    m_Localized: "Joystick: move \xB7 A: swing your broom at the mice"
    m_Metadata:
      m_Items: []
  - m_Id: 17129633087488
    m_Localized: Jump
    m_Metadata:
      m_Items: []
  - m_Id: 17129679224832
    m_Localized: Duck
    m_Metadata:
      m_Items: []
  - m_Id: 17129679224833
    m_Localized: Turbo
    m_Metadata:
      m_Items: []
  - m_Id: 17129679224834
    m_Localized: Swing
    m_Metadata:
      m_Items: []
  - m_Id: 17129679224835
    m_Localized: "\xB7 Grab a grandma and take her across the road: <b>+50</b> points.\n\xB7 Last 30 seconds: every grandma is worth <b>+100</b>.\n\xB7 Get run over and you lose <b>20</b> points and the grandma goes flying.\n\xB7 Without a grandma you run faster and can <b>shove</b> your rivals... into the traffic!\n\xB7 Trucks leak slippery oil. Traffic gets busier over time."
    m_Metadata:
      m_Items: []
  - m_Id: 17129679224836
    m_Localized: "\xB7 Jump over the giant churro when it reaches your float.\n\xB7 Watch out! The kid brakes and reverses without warning.\n\xB7 Duck under the beach balls: <b>you cannot jump</b> while ducking.\n\xB7 Cannonballs into the pool splash the screen.\n\xB7 3 rounds. The more rivals fall before you, the <b>more points</b>."
    m_Metadata:
      m_Items: []
  - m_Id: 17129679224837
    m_Localized: "\xB7 Mow grass to fill bags: they trail behind you and slow you down a bit.\n\xB7 They only score when emptied into <b>your bin</b>, in your corner.\n\xB7 Drive through a rival's tail to cut their bags loose and take them.\n\xB7 Ram them with the <b>turbo</b>: they lose 3 bags and spin out.\n\xB7 Final frenzy (30 s): the grass grows back and every bag is worth <b>x2</b>."
    m_Metadata:
      m_Items: []
  - m_Id: 17129679224838
    m_Localized: "\xB7 Swing your broom at the mice: <b>1</b> point each, <b>5</b> for the golden one.\n\xB7 Several in one swing: the points multiply.\n\xB7 They run from you and hide under the shelves and in the holes.\n\xB7 Hit a rival to <b>stun</b> them for a moment.\n\xB7 Most points after 90 seconds wins."
    m_Metadata:
      m_Items: []
  - m_Id: 17129679224839
    m_Localized: "Joystick / WASD: move \xB7 A / Space: shove a rival (only without a grandma)"
    m_Metadata:
      m_Items: []
  - m_Id: 17129679224840
    m_Localized: "A / Space: jump the churro \xB7 Hold B / Ctrl: duck"
    m_Metadata:
      m_Items: []
  - m_Id: 17129679224841
    m_Localized: "Joystick / WASD: drive \xB7 A / Space: turbo (5 s recharge) \xB7 Your bin: get close and the bags unload"
    m_Metadata:
      m_Items: []
  - m_Id: 17129679224842
    m_Localized: "Joystick / WASD: move \xB7 A / Space: swing your broom"
    m_Metadata:
      m_Items: []
  - m_Id: 17129679224843
    m_Localized: "Shove"
    m_Metadata:
      m_Items: []
  - m_Id: 17129679224844
    m_Localized: RESULTS
    m_Metadata:
      m_Items: []
  references:
