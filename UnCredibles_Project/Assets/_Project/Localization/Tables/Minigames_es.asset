  m_TableData:
  - m_Id: 326238208
    m_Localized: Ayuda a la abuela
    m_Metadata:
      m_Items: []
  - m_Id: 359792640
    m_Localized: "Calma al ni\xF1o"
    m_Metadata:
      m_Items: []
  - m_Id: 359792641
    m_Localized: "Corta el c\xE9sped"
    m_Metadata:
      m_Items: []
  - m_Id: 359792642
    m_Localized: Ratones en el garaje
    m_Metadata:
      m_Items: []
  - m_Id: 359792643
    m_Localized: "\xA1YA!"
    m_Metadata:
      m_Items: []
  - m_Id: 359792644
    m_Localized: RATONES EN EL GARAJE
    m_Metadata:
      m_Items: []
  - m_Id: 359792645
    m_Localized: 'MUEVE: STICK / WASD    ESCOBAZO: A / ESPACIO'
    m_Metadata:
      m_Items: []
  - m_Id: 359792646
    m_Localized: "\xA1A BARRER!"
    m_Metadata:
      m_Items: []
  - m_Id: 359792647
    m_Localized: RESULTADOS
    m_Metadata:
      m_Items: []
  - m_Id: 359792648
    m_Localized: Jugador {0}
    m_Metadata:
      m_Items: []
  - m_Id: 359792649
    m_Localized: '{0} ratones'
    m_Metadata:
      m_Items: []
  - m_Id: 359792650
    m_Localized: Ronda {0} / {1}
    m_Metadata:
      m_Items: []
  - m_Id: 359792651
    m_Localized: "RONDA 1\n<size=40%>ESPACIO / A: salta el churro  \xB7  CTRL / B:
      ag\xE1chate ante las pelotas</size>"
    m_Metadata:
      m_Items: []
  - m_Id: 359792652
    m_Localized: RONDA {0}
    m_Metadata:
      m_Items: []
  - m_Id: 359792653
    m_Localized: "\xA1{0} sobrevive!"
    m_Metadata:
      m_Items: []
  - m_Id: 359792654
    m_Localized: "\xA1Han ca\xEDdo todos!"
    m_Metadata:
      m_Items: []
  - m_Id: 359792655
    m_Localized: "\xA1RECTA FINAL!\n<size=60%>Cada abuela vale x2</size>"
    m_Metadata:
      m_Items: []
  - m_Id: 359792656
    m_Localized: "\xA1A CORTAR!\n<size=50%>ESPACIO / A: TURBO  \xB7  choca con turbo
      para quitar bolsas\nDescarga las bolsas en tu contenedor</size>"
    m_Metadata:
      m_Items: []
  - m_Id: 359792657
    m_Localized: "\xA1FRENES\xCD FINAL!\n<size=60%>El c\xE9sped vuelve a crecer \xB7
      bolsas x2</size>"
    m_Metadata:
      m_Items: []
  - m_Id: 11229052665856
    m_Localized: "Joystick: mu\xE9vete \xB7 Coge a una abuela y cr\xFAzala sin que
      te atropellen"
    m_Metadata:
      m_Items: []
  - m_Id: 11229094608896
    m_Localized: "A: salta el churro \xB7 Mant\xE9n B: ag\xE1chate ante las pelotas"
    m_Metadata:
      m_Items: []
  - m_Id: 11229094608897
    m_Localized: "Joystick: conduce \xB7 A: turbo \xB7 Vac\xEDa las bolsas en tu
      contenedor"
    m_Metadata:
      m_Items: []
  - m_Id: 11229094608898
    m_Localized: "Joystick: mu\xE9vete \xB7 A: escobazo a las ratas"
    m_Metadata:
      m_Items: []
  references:
