  m_Name: Minigames_es
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: es
  m_SharedData: {fileID: 11400000, guid: 169b9029a6299754cbc998d0122e2315, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 326238208
    m_Localized: Ayuda a la abuela
    m_Metadata:
      m_Items: []
  - m_Id: 359792640
    m_Localized: "Calma al ni\xF1o"
    m_Metadata:
      m_Items: []
  - m_Id: 359792641
    m_Localized: "Corta el c\xE9sped"
    m_Metadata:
      m_Items: []
  - m_Id: 359792642
    m_Localized: Ratones en el garaje
    m_Metadata:
      m_Items: []
  - m_Id: 359792643
    m_Localized: "\xA1YA!"
    m_Metadata:
      m_Items: []
  - m_Id: 359792644
    m_Localized: RATONES EN EL GARAJE
    m_Metadata:
      m_Items: []
  - m_Id: 359792645
    m_Localized: 'MUEVE: STICK / WASD    ESCOBAZO: A / ESPACIO'
    m_Metadata:
      m_Items: []
  - m_Id: 359792646
    m_Localized: "\xA1A BARRER!"
    m_Metadata:
      m_Items: []
  - m_Id: 359792647
    m_Localized: RESULTADOS
    m_Metadata:
      m_Items: []
  - m_Id: 359792648
    m_Localized: Jugador {0}
    m_Metadata:
      m_Items: []
  - m_Id: 359792649
    m_Localized: '{0} ratones'
    m_Metadata:
      m_Items: []
  - m_Id: 359792650
    m_Localized: Ronda {0} / {1}
    m_Metadata:
      m_Items: []
  - m_Id: 359792651
    m_Localized: "RONDA 1\n<size=40%>ESPACIO / A: salta el churro  \xB7  CTRL / B:
      ag\xE1chate ante las pelotas</size>"
    m_Metadata:
      m_Items: []
  - m_Id: 359792652
    m_Localized: RONDA {0}
    m_Metadata:
      m_Items: []
  - m_Id: 359792653
    m_Localized: "\xA1{0} sobrevive!"
    m_Metadata:
      m_Items: []
  - m_Id: 359792654
    m_Localized: "\xA1Han ca\xEDdo todos!"
    m_Metadata:
      m_Items: []
  - m_Id: 359792655
    m_Localized: "\xA1RECTA FINAL!\n<size=60%>Cada abuela vale x2</size>"
    m_Metadata:
      m_Items: []
  - m_Id: 359792656
    m_Localized: "\xA1A CORTAR!\n<size=50%>ESPACIO / A: TURBO  \xB7  choca con turbo
      para quitar bolsas\nDescarga las bolsas en tu contenedor</size>"
    m_Metadata:
      m_Items: []
  - m_Id: 359792657
    m_Localized: "\xA1FRENES\xCD FINAL!\n<size=60%>El c\xE9sped vuelve a crecer \xB7
      bolsas x2</size>"
    m_Metadata:
      m_Items: []
  - m_Id: 11229052665856
    m_Localized: "Joystick: mu\xE9vete \xB7 Coge a una abuela y cr\xFAzala sin que
      te atropellen"
    m_Metadata:
      m_Items: []
  - m_Id: 11229094608896
    m_Localized: "A: salta el churro \xB7 Mant\xE9n B: ag\xE1chate ante las pelotas"
    m_Metadata:
      m_Items: []
  - m_Id: 11229094608897
    m_Localized: "Joystick: conduce \xB7 A: turbo \xB7 Vac\xEDa las bolsas en tu
      contenedor"
    m_Metadata:
      m_Items: []
  - m_Id: 11229094608898
    m_Localized: "Joystick: mu\xE9vete \xB7 A: escobazo a las ratas"
    m_Metadata:
      m_Items: []
  - m_Id: 17129633087488
    m_Localized: Saltar
    m_Metadata:
      m_Items: []
  - m_Id: 17129679224832
    m_Localized: Agacharse
    m_Metadata:
      m_Items: []
  - m_Id: 17129679224833
    m_Localized: Turbo
    m_Metadata:
      m_Items: []
  - m_Id: 17129679224834
    m_Localized: Escobazo
    m_Metadata:
      m_Items: []
  - m_Id: 17129679224835
    m_Localized: "\xB7 Coge una abuela y ll\xE9vala a la otra acera: <b>+50</b> puntos.\n\xB7 \xDAltimos 30 segundos: cada abuela vale <b>+100</b>.\n\xB7 Si te atropellan pierdes <b>20</b> puntos y la abuela sale volando.\n\xB7 Sin abuela corres m\xE1s y puedes <b>empujar</b> a tus rivales... \xA1hacia los coches!\n\xB7 Los camiones dejan manchas de aceite que resbalan. El tr\xE1fico va a m\xE1s."
    m_Metadata:
      m_Items: []
  - m_Id: 17129679224836
    m_Localized: "\xB7 Salta el churro gigante cuando pase por tu flotador.\n\xB7 \xA1Ojo! El ni\xF1o frena y cambia de sentido sin avisar.\n\xB7 Ag\xE1chate para esquivar las pelotas de playa: agachado <b>no puedes saltar</b>.\n\xB7 Los bombazos en la piscina salpican la pantalla.\n\xB7 3 rondas. Cuantos m\xE1s rivales caigan antes que t\xFA, <b>m\xE1s puntos</b>."
    m_Metadata:
      m_Items: []
  - m_Id: 17129679224837
    m_Localized: "\xB7 Corta c\xE9sped para llenar bolsas: te siguen en fila y te frenan un poco.\n\xB7 Solo punt\xFAan al vaciarlas en <b>tu contenedor</b>, en tu esquina.\n\xB7 Cruza la cola de un rival para soltarle las bolsas y qu\xE9datelas.\n\xB7 Emb\xEDstelo con el <b>turbo</b>: pierde 3 bolsas y se queda girando.\n\xB7 Frenes\xED final (30 s): el c\xE9sped vuelve a crecer y cada bolsa vale <b>x2</b>."
    m_Metadata:
      m_Items: []
  - m_Id: 17129679224838
    m_Localized: "\xB7 Da escobazos a los ratones: <b>1</b> punto cada uno y <b>5</b> el dorado.\n\xB7 Varios de un solo escobazo: los puntos se multiplican.\n\xB7 Huyen de ti y se esconden bajo las estanter\xEDas y en los agujeros.\n\xB7 Dale a un rival para <b>aturdirlo</b> un momento.\n\xB7 Gana quien tenga m\xE1s puntos a los 90 segundos."
    m_Metadata:
      m_Items: []
  - m_Id: 17129679224839
    m_Localized: "Joystick / WASD: mu\xE9vete \xB7 A / Espacio: empuja a un rival (solo sin abuela)"
    m_Metadata:
      m_Items: []
  - m_Id: 17129679224840
    m_Localized: "A / Espacio: salta el churro \xB7 Mant\xE9n B / Ctrl: ag\xE1chate"
    m_Metadata:
      m_Items: []
  - m_Id: 17129679224841
    m_Localized: "Joystick / WASD: conduce \xB7 A / Espacio: turbo (recarga en 5 s) \xB7 Tu contenedor: ac\xE9rcate y las bolsas se vac\xEDan solas"
    m_Metadata:
      m_Items: []
  - m_Id: 17129679224842
    m_Localized: "Joystick / WASD: mu\xE9vete \xB7 A / Espacio: escobazo"
    m_Metadata:
      m_Items: []
  - m_Id: 17129679224843
    m_Localized: "Empujar"
    m_Metadata:
      m_Items: []
  - m_Id: 17129679224844
    m_Localized: RESULTADOS
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
